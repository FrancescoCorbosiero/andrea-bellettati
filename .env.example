# Copia in .env (NON va nel repo) e compila.

# ── Dominio (label di Caddy e URL assoluti: sitemap, canonical, Open Graph) ──
SITE_DOMAIN=andreabellettati.it
SITE_DOMAIN_ALT=www.andreabellettati.it
# In sviluppo locale non serve: il default è https://andreabellettati.it
NEXT_PUBLIC_SITE_URL=https://andreabellettati.it

# ── AWS SES: email dei questionari (/api/richiesta) ──────────────────
# Regione in cui hai verificato il dominio in SES (es. eu-west-1, eu-south-1).
AWS_REGION=eu-west-1
# Utente IAM con il SOLO permesso ses:SendEmail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Mittente su un dominio/indirizzo verificato in SES.
SES_FROM="Sito Andrea Bellettati <sito@andreabellettati.it>"
# Dove arrivano i due questionari (più indirizzi separati da virgola).
# Senza, consulenze@ e partners@ del dominio del sito. Con SES ancora in
# sandbox anche i destinatari vanno verificati.
SES_TO_CONSULENZE=consulenze@andreabellettati.it
SES_TO_PARTNER=partners@andreabellettati.it
# Facoltativo: configuration set SES per metriche e rimbalzi.
SES_CONFIGURATION_SET=
# true = non invia, stampa l'email nei log (prove/staging).
SES_DRY_RUN=false

# ── Dati legali ──────────────────────────────────────────────────────
# Partita IVA di Andrea: compare nei piè di pagina, nell'informativa privacy
# e nelle email. Entra al build: dopo averla scritta, docker compose up -d --build.
NEXT_PUBLIC_PARTITA_IVA=

# ── Facoltativo ──────────────────────────────────────────────────────
# Codice di verifica di Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
