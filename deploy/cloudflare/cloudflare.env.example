# Copia in deploy/cloudflare/cloudflare.env (resta fuori da git) e compila.
# Lo usa solo deploy/cloudflare/cloudflare.sh, non il sito: il token non
# finisce nel container.

# Cloudflare → My Profile → API Tokens → Create Token → Custom token, sulla
# sola zona del sito, con i permessi:
#   Zone · Cache Rules · Edit
#   Zone · Zone Settings · Edit
#   Zone · Cache Purge · Purge
CLOUDFLARE_API_TOKEN=

# Panoramica del dominio su Cloudflare, colonna di destra: "Zone ID".
CLOUDFLARE_ZONE_ID=

# Facoltativo: se manca si usa SITE_DOMAIN del .env del sito.
# SITE_DOMAIN=andreabellettati.it
